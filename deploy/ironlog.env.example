# /etc/ironlog/ironlog.env — lido pelo systemd (permissão 0640 root:ironlog)

# Endereço público (EXATO, com https). A passkey fica presa a este domínio:
# trocar depois invalida todas as passkeys cadastradas.
ORIGIN=https://ironlog.edge.seg.br

# Escute só no IP da LXC (o NPM acessa por aqui). Evite 0.0.0.0 sem firewall.
HOST=__BIND_IP__
PORT=3000

DATA_DIR=/var/lib/ironlog
APP_DIR=/opt/ironlog
BACKUP_DIR=/var/backups/ironlog

# Opcionais
#MAX_PASSKEYS=2
#SESSION_DAYS=60
#INVITE_HOURS=72
#ALERT_SNOOZE_MIN=30
#ALERT_MAX_REPEATS=4
#VAPID_SUBJECT=mailto:voce@seg.br
#LOG_LEVEL=info
#KEEP_DAYS=14        # backups diários mantidos
#KEEP_WEEKS=8        # backups semanais (domingo) mantidos
#REMOTE_COPY=usuario@servidor:/caminho/backups/   # cópia extra via rsync (opcional)
